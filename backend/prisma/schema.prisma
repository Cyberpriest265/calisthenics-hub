// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. User Model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  purchases Purchase[]
}

enum Role {
  STUDENT
  ADMIN
}

// 2. Course Model
model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  thumbnail   String?  // Optional field
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  purchases   Purchase[]
}

// 3. Lesson Model
model Lesson {
  id        String @id @default(uuid())
  title     String
  videoUrl  String
  position  Int    // To order lessons (1, 2, 3...)
  
  courseId  String
  course    Course @relation(fields: [courseId], references: [id])
}

// 4. Purchase Model (Connects Users and Courses)
model Purchase {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  amountPaid  Float
  purchasedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId]) // A user can only buy a specific course once
}
